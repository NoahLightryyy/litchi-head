          "holdings": {
            "items": {
              "$ref": "#/components/schemas/Holding"
            },
            "type": "array",
            "title": "Holdings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "etf_symbol",
          "as_of",
          "published_date",
          "evidence_id",
          "coverage",
          "holdings"
        ],
        "title": "HoldingsDisclosure"
      },
      "JobError": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "SOURCE_UNAVAILABLE",
