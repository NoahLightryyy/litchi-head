{
  "openapi": "3.1.0",
  "info": {
    "title": "Policy capital evidence contract (design only)",
    "version": "1.0.0"
  },
  "paths": {
    "/api/research/evidence/{package_id}": {
      "get": {
        "summary": "Evidence Contract",
        "operationId": "evidence_contract_api_research_evidence__package_id__get",
        "parameters": [
          {
            "name": "package_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Package Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvidencePackage"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractError"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractError"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        }
      }
    },
    "/api/research/jobs": {
      "post": {
        "summary": "Create Job",
        "operationId": "create_job_api_research_jobs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchJob"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractError"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractError"
                }
              }
            }
          }
        }
      }
    },
    "/api/research/jobs/{job_id}": {
      "get": {
        "summary": "Get Job",
        "operationId": "get_job_api_research_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchJob"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractError"
                }
              }
            },
            "description": "Not Found"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractError"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/research/execution-preview": {
      "post": {
        "summary": "Preview",
        "operationId": "preview_api_research_execution_preview_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExecutionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExecutionPreview"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractError"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractError"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Claim": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          },
          "assessment": {
            "type": "string",
            "enum": [
              "supported",
              "inferred",
              "insufficient",
              "contradicted"
            ],
            "title": "Assessment"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "text",
          "assessment",
          "evidence_ids",
          "limitations"
        ],
        "title": "Claim"
      },
      "ContractError": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "PACKAGE_NOT_FOUND",
              "SOURCE_UNAVAILABLE",
              "VALIDATION_ERROR",
              "IDEMPOTENCY_CONFLICT"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "retryable": {
            "type": "boolean",
            "title": "Retryable"
          },
          "retry_after_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After Seconds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable",
          "retry_after_seconds"
        ],
        "title": "ContractError"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "canonical_document_id": {
            "type": "string",
            "minLength": 1,
            "title": "Canonical Document Id"
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "title": "Publisher"
          },
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "official_repost",
              "reporting"
            ],
            "title": "Role"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "title": "Locator"
          },
          "authored_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authored Date"
          },
          "published_date": {
            "type": "string",
            "format": "date",
            "title": "Published Date"
          },
          "effective_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Date"
          },
          "effective_date_status": {
            "type": "string",
            "enum": [
              "stated",
              "not_stated",
              "conflicting"
            ],
            "title": "Effective Date Status"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "title": "Retrieved At"
          },
          "snapshot_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot Sha256"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "title": "Summary"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "canonical_document_id",
          "url",
          "publisher",
          "role",
          "title",
          "locator",
          "authored_date",
          "published_date",
          "effective_date",
          "effective_date_status",
          "retrieved_at",
          "snapshot_sha256",
          "summary"
        ],
        "title": "Evidence"
      },
      "EvidencePackage": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "package_id": {
            "type": "string",
            "minLength": 1,
            "title": "Package Id"
          },
          "subject_kind": {
            "type": "string",
            "enum": [
              "sector",
              "stock",
              "etf"
            ],
            "title": "Subject Kind"
          },
          "subject_id": {
            "type": "string",
            "minLength": 1,
            "title": "Subject Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "partial",
              "verified_scope"
            ],
            "title": "Status"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "title": "Claims"
          },
          "holdings": {
            "items": {
              "$ref": "#/components/schemas/HoldingsDisclosure"
            },
            "type": "array",
            "title": "Holdings"
          },
          "gaps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Gaps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "package_id",
          "subject_kind",
          "subject_id",
          "status",
          "evidence",
          "claims",
          "holdings",
          "gaps"
        ],
        "title": "EvidencePackage"
      },
      "ExecutionPreview": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "blocked"
            ],
            "title": "Status"
          },
          "evidence_package_id": {
            "type": "string",
            "title": "Evidence Package Id"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "estimated_cost": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Cost"
          },
          "remaining_cash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining Cash"
          },
          "gaps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Gaps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "evidence_package_id",
          "quantity",
          "estimated_cost",
          "remaining_cash",
          "gaps"
        ],
        "title": "ExecutionPreview"
      },
      "ExecutionRequest": {
        "properties": {
          "evidence_package_id": {
            "type": "string",
