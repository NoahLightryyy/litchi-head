          },
          "instrument_kind": {
            "type": "string",
            "enum": [
              "stock",
              "etf"
            ],
            "title": "Instrument Kind"
          },
          "symbol": {
            "type": "string",
            "pattern": "^\\d{6}$",
            "title": "Symbol"
          },
          "market": {
            "type": "string",
            "enum": [
              "SH",
              "SZ"
            ],
            "title": "Market"
          },
          "side": {
            "type": "string",
            "const": "buy",
            "title": "Side",
            "default": "buy"
          },
          "order_type": {
            "type": "string",
            "const": "limit",
            "title": "Order Type",
            "default": "limit"
          },
          "cash_available_cny": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cash Available Cny"
          },
          "user_budget_cny": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Budget Cny"
          },
          "limit_price_cny": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit Price Cny"
          },
          "quote_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quote At"
          },
          "permission_confirmed": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Permission Confirmed"
          },
          "rules": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TradingRule"
              },
              {
                "type": "null"
              }
            ]
          },
          "fees": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FeeSchedule"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "evidence_package_id",
          "instrument_kind",
          "symbol",
          "market",
          "cash_available_cny",
          "user_budget_cny",
          "limit_price_cny",
          "quote_at",
          "permission_confirmed",
          "rules",
          "fees"
        ],
        "title": "ExecutionRequest"
      },
      "FeeSchedule": {
        "properties": {
          "version": {
            "type": "string",
            "title": "Version"
          },
          "source_reference": {
            "type": "string",
            "minLength": 1,
            "title": "Source Reference"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time",
            "title": "Verified At"
          },
          "commission_rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Commission Rate"
          },
          "minimum_commission_cny": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Minimum Commission Cny"
          },
          "additional_rate": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Additional Rate"
          },
          "additional_fixed_cny": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              }
            ],
            "title": "Additional Fixed Cny"
          },
          "includes_all_applicable_costs": {
            "type": "boolean",
            "const": true,
            "title": "Includes All Applicable Costs"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "source_reference",
          "verified_at",
          "commission_rate",
          "minimum_commission_cny",
          "additional_rate",
          "additional_fixed_cny",
          "includes_all_applicable_costs"
        ],
        "title": "FeeSchedule"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Holding": {
        "properties": {
